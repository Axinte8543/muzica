### Sample env file for backend (copy to .env and edit for production)
# Django
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (optional - defaults to sqlite if not set)
# DB_ENGINE=postgres
# DB_NAME=licenta_music_db
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_HOST=db
# DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/1
USE_REDIS_CACHE=true
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Sentry (optional)
# SENTRY_DSN=
