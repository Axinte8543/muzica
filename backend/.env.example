# Django
SECRET_KEY=django-insecure-change-me-please-set-a-long-random-secret-key-at-least-32-bytes
DEBUG=True
ALLOWED_HOSTS=

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=True

# Database
# Use: sqlite | postgres
DB_ENGINE=postgres
DB_NAME=licenta_music_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_HOST=127.0.0.1
DB_PORT=5432

# Spotify (Client Credentials flow)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# MusicBrainz (no auth, but requires a descriptive User-Agent w/ contact)
MUSICBRAINZ_APP_NAME=licenta-muzica
MUSICBRAINZ_CONTACT_EMAIL=

# Last.fm (optional, for similar artists)
# Create an API account at https://www.last.fm/api/account/create
LASTFM_API_KEY=
